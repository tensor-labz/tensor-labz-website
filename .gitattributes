# Normalize all text files to LF in the repo and on checkout (every OS).
# Prevents the CRLF/LF churn that otherwise trips prettier (endOfLine: 'lf').
* text=auto eol=lf

# Binary assets — never normalize or diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4   binary
*.webm  binary
*.pdf   binary
*.zip   binary

# Shell scripts must stay LF even on Windows checkouts (they run in bash/CI)
*.sh text eol=lf

# Lockfile is generated — collapse in diffs, exclude from language stats
package-lock.json linguist-generated=true

# Vendored submodules — exclude from GitHub language statistics
docs/**         linguist-vendored
image-lambda/** linguist-vendored
