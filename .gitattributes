# Normalize all text files to LF in the repo and on checkout (every OS).
# Prevents the CRLF/LF churn that otherwise trips prettier (endOfLine: 'lf').
* text=auto eol=lf

# Binary assets — never normalize or diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4   binary
*.webm  binary
*.pdf   binary
*.zip   binary
