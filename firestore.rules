rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public content + config collections: anyone can read; only authenticated
    // (admin) users can write. Auth is Firebase Auth (request.auth).
    function isContent(c) {
      return c in [
        'services', 'posts', 'projects',
        'hero', 'about', 'contact', 'social',
        'about_media', 'company_info', 'site_settings',
        'table_config', 'form_config', 'page_config'
      ];
    }

    match /{collection}/{docId} {
      allow read: if isContent(collection);
      allow write: if isContent(collection) && request.auth != null;

      // Audit trail subcollection on any content doc.
      match /logs/{logId} {
        allow read, write: if request.auth != null;
      }
    }

    // Everything else (e.g. future private collections) is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
