rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public content collections: anyone can read; only authenticated
    // (admin) users can write. Auth is Firebase Auth (request.auth).
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /logs/{logId} {
        allow read, write: if request.auth != null;
      }
    }

    // Everything else is denied by default until migrated.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
